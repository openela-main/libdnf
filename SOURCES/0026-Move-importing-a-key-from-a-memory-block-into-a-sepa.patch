     pubkey = rpmPubkeyNew(pkt, len);
     if (pubkey == NULL) {
         ret = FALSE;
@@ -149,8 +122,6 @@ dnf_keyring_add_public_key(rpmKeyring keyring,
     g_debug("added missing public key %s to rpmdb", filename);
     ret = TRUE;
 out:
-    if (pkt != NULL)
-        free(pkt); /* yes, free() */
